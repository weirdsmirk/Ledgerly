# Backend environment overrides (copy to backend/.env and adjust as needed)

# Port the API listens on (unique default: 8734 — chosen to avoid colliding
# with common dev ports like 3000/3001/5173/8000)
PORT=8734

# SQLite database file (default: backend/app.db — relative paths resolve
# against your current working directory, so prefer an absolute path)
# DB_PATH=/Users/you/BudgetOpenCode/backend/app.db