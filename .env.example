# Environment overrides (copy to .env and adjust as needed)

# Port the API server listens on (unique default: 8734 — chosen to avoid
# colliding with common dev ports like 3000/3001/5173/8000).
PORT=8734

# Where the Vite dev client should call the API. Leave unset (or set to /api)
# in production — the API server serves the built client on the same origin.
VITE_API_URL=http://localhost:8734/api

# SQLite database file (default: <project root>/data/database.sqlite — relative
# paths resolve against your current working directory, so prefer an absolute path)
# DB_PATH=/Users/you/Ledgerly/data/database.sqlite